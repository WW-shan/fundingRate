# ==================== Telegram 配置 ====================
TG_BOT_TOKEN=your_telegram_bot_token_here
TG_CHAT_ID=your_telegram_chat_id_here

# ==================== Web 配置 ====================
WEB_HOST=0.0.0.0
WEB_PORT=5000
SECRET_KEY=change_this_to_a_random_secret_key

# Web 认证
WEB_USERNAME=admin
# 推荐配置哈希（生成方式: python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('你的密码'))"）
WEB_PASSWORD_HASH=
# 未配置哈希时可使用明文密码（默认 admin123，仅建议本地使用）
# WEB_PASSWORD=admin123

# ==================== 数据库 ====================
DATABASE_PATH=data/database.db

# ==================== 日志 ====================
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# ==================== 代理配置（可选，按交易所） ====================
# 中国大陆等受限网络环境下需要配置代理才能访问部分交易所
# 支持按交易所单独配置，未配置的交易所将直连
# BINANCE_PROXY=http://127.0.0.1:10808
# OKX_PROXY=http://127.0.0.1:10808
# BYBIT_PROXY=http://127.0.0.1:10808
# GATE_PROXY=http://127.0.0.1:10808
# BITGET_PROXY=http://127.0.0.1:10808
# 或统一配置（所有交易所共用）：
# PROXY_URL=http://127.0.0.1:10808
